@page "{id:int}"
@model webasp.Pages.SuperSecretPageOnlyForAdmin666EditModel
@{
    Layout = "LayoutLite";
    ViewData["Title"] = "Админ редактирование";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Редактирование объявления</h5>
                <a asp-page="/MyAd" class="btn btn-sm btn-outline-light">← Назад</a>
            </div>

            <div class="card-body">
                <form id="editForm" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label font-weight-bold">Название объявления</label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Введите название" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label font-weight-bold">Описание</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="Введите описание"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block font-weight-bold">Текущее изображение</label>
                        @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                        {
                            <div class="mb-2">
                                <img src="@Model.CurrentImagePath" alt="Текущее фото" class="img-thumbnail" style="max-height: 180px; object-fit: cover;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">Изображение отсутствует</p>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ImageFile" class="form-label font-weight-bold">Заменить фотографию (необязательно)</label>
                        <input asp-for="Input.ImageFile" type="file" class="form-control" accept="image/*" />
                        <div class="form-text">Загрузите новый файл, только если хотите заменить текущее фото.</div>
                    </div>
                </form>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Вы действительно хотите удалить это объявление? Это действие нельзя отменить.');">
                        <button type="submit" class="btn btn-outline-danger">
                            Удалить
                        </button>
                    </form>

                    <div class="d-flex gap-2">
                        <a asp-page="/MyAd" class="btn btn-primary">Отмена</a>
                        <button type="submit" form="editForm" class="btn btn-success px-4">Сохранить изменения</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
