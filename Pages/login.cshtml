@page
@model webasp.Pages.loginModel
@{
    ViewData["Title"] = "Вход";
}
<div class="d-flex align-items-center justify-content-center vh-100 bg-white">
    <div class="p-5 bg-white rounded shadow" style="width: 400px;">
        <h1 class="text-center mb-4">Вход</h1>
        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Логин</label>
                <input asp-for="Input.Username" class="form-control">
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Пароль</label>
                <input asp-for="Input.Password" type="password" class="form-control">
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            @*<div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="exampleCheck1">
                <label class="form-check-label" for="exampleCheck1">Запомни меня</label>
            </div>*@

            <div class="text-center">
                <button type="submit" class=" btn btn-primary">Войти</button>
            </div>

            <div class="mt-4 text-center">
                <span class="small text-muted">
                    Впервые здесь?
                    <a href="/register" class="text-decoration-none">Зарегистрироваться</a>
                </span>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}