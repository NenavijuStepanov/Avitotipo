@page
@model webasp.Pages.SuperSecretPageOnlyForAdmin666Model
@{
    Layout = "LayoutLite";
    ViewData["Title"] = "Админ Панель";
}
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-area="" asp-page="/Index">
                Админ Панель
            </a>
        </div>
    </nav>
</header>

<form method="get" class="mb-4">
    <div class="input-group shadow-sm">
        <input type="text"
               asp-for="SearchTerm"
               class="form-control"
               placeholder="Поиск по названию или описанию..." />

        <button type="submit" class="btn btn-primary">
            Искать
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <a asp-page="/Index" class="btn btn-outline-secondary">
                Сбросить
            </a>
        }
    </div>
</form>

@if (!Model.AdsList.Any())
{
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="alert alert-warning">
            По запросу «<strong>@Model.SearchTerm</strong>» ничего не найдено.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Объявлений пока нет. Будьте первым, кто его добавит!
        </div>
    }
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ad in Model.AdsList)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a asp-page="/SuperSecretPageOnlyForAdmin666Edit"
                       asp-route-id="@ad.Id"
                       class="btn btn-sm btn-light position-absolute top-0 end-0 m-2 shadow-sm rounded-circle d-flex align-items-center justify-content-center"
                       style="width: 34px; height: 34px; z-index: 10;"
                       title="Редактировать объявление">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9 1.5 15.5 8 13.707z" />
                        </svg>
                    </a>
                    @if (!string.IsNullOrEmpty(ad.ImagePath))
                    {
                        <img src="@ad.ImagePath" class="card-img-top" alt="@ad.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                            Нет фотографии
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@ad.Title</h5>
                        <p class="card-text text-secondary">@ad.Description</p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Автор: <strong>@(ad.User?.Username ?? "Неизвестен")</strong></small>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}