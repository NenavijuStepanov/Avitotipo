@page 
@model webasp.Pages.registerModel
@{
    ViewData["Title"] = "Регистрация";
}
<div class="d-flex align-items-center justify-content-center vh-100 bg-white">

    <div class="p-5 bg-white rounded shadow" style="width: 400px;">
        <h1 class="text-center mb-4">Вход</h1>
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Username" for="exampleInputEmail1" class="form-label">Придумайте логин</label>
                <input asp-for="Input.Username"  name="username" type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" for="exampleInputPassword1" class="form-label">Придумайте пароль</label>
                <input asp-for="Input.Password" name="password" type="password" class="form-control" id="exampleInputPassword1">
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" for="exampleInputPassword1" class="form-label">Повторите пароль</label>
                <input asp-for="Input.ConfirmPassword" name="password" type="password" class="form-control" id="exampleInputPassword1">
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="text-center">
            <button type="submit" class="btn btn-primary">Регистрация</button>
            </div>
            <div class="mt-4 text-center">
                <span class="small text-muted">
                    Есть аккаунт?
                    <a href="/login" class="text-decoration-none">Войти</a>
                </span>
            </div>
        </form>
    </div>
</div>