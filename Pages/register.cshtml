@page
@model webasp.Pages.registerModel
@{
    ViewData["Title"] = "Регистрация";
}
<div class="d-flex align-items-center justify-content-center vh-100 bg-white">
    <div class="p-5 bg-white rounded shadow" style="width: 400px;">
        <h1 class="text-center mb-4">Регистрация</h1>
        <form method="post">

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Придумайте логин</label>
                <input asp-for="Input.Username" class="form-control" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Придумайте пароль</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Повторите пароль</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
            </div>

            <div class="mt-4 text-center">
                <span class="small text-muted">
                    Есть аккаунт?
                    <a href="/login" class="text-decoration-none">Войти</a>
                </span>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}