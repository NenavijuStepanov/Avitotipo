@page
@model IndexModel
@{
    ViewData["Title"] = "Главная страница";
    }

<div class="d-flex justify-content-between align-items-center w-100">
    <form method="post" class="m-0" asp-page-handler="LogOut">
        <button type="submit" class="btn btn-primary">Выйти</button>
    </form>
    <a href="/Profile">Мой профиль</a>
</div>


<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Имя</th>
        </tr> 
    </thead> 
    <tbody> 
        @foreach (var user in Model.UsersList) {
    <tr> 
        <td>@user.Id</td> 
        <td>@user.Username</td> 
    </tr>
}
</tbody> 
</table>



@if (!Model.AdsList.Any())
{
    <div class="alert alert-info">Объявлений пока нет. Будьте первым, кто его добавит!</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ad in Model.AdsList)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(ad.ImagePath))
                    {
                        <img src="@ad.ImagePath" class="card-img-top" alt="@ad.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                            Нет фотографии
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@ad.Title</h5>
                        <p class="card-text text-secondary">@ad.Description</p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Автор: <strong>@(ad.User?.Username ?? "Неизвестен")</strong></small>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}